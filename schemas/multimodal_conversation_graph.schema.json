{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hightorque.local/schemas/multimodal-conversation-graph-v1.json",
  "title": "HT multimodal conversation graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_type", "session_id", "created_at", "source", "processing", "nodes", "edges", "statistics", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "context_type": {"const": "multimodal_conversation_graph"},
    "session_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_graph", "session_memory", "scene_context", "participant_context"],
      "properties": {
        "scene_graph": {"$ref": "#/$defs/sourceFile"},
        "session_memory": {"$ref": "#/$defs/sourceFile"},
        "scene_context": {"$ref": "#/$defs/sourceFile"},
        "participant_context": {"$ref": "#/$defs/sourceFile"}
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker_alignment", "temporal_alignment", "dialogue_semantics_are_inferred"],
      "properties": {
        "speaker_alignment": {"const": "participant_context_session_id_and_hash_v1"},
        "temporal_alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "minimum_overlap_ms", "scene_coverage_start_ms", "scene_coverage_end_ms", "linked_turn_ids", "unlinked_turn_ids"],
          "properties": {
            "algorithm": {"const": "minimum_interval_overlap_v1"},
            "minimum_overlap_ms": {"const": 120},
            "scene_coverage_start_ms": {"type": ["integer", "null"], "minimum": 0},
            "scene_coverage_end_ms": {"type": ["integer", "null"], "minimum": 0},
            "linked_turn_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "unlinked_turn_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "dialogue_semantics_are_inferred": {"const": true}
      }
    },
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "persons", "visual_identities", "scenes", "objects", "topics", "opinions", "intents", "visual_interactions", "dialogue_relations", "temporally_linked_turns", "unlinked_turns", "observed_edges", "inferred_edges"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0},
        "persons": {"type": "integer", "minimum": 0},
        "visual_identities": {"type": "integer", "minimum": 0},
        "scenes": {"type": "integer", "minimum": 0},
        "objects": {"type": "integer", "minimum": 0},
        "topics": {"type": "integer", "minimum": 0},
        "opinions": {"type": "integer", "minimum": 0},
        "intents": {"type": "integer", "minimum": 0},
        "visual_interactions": {"type": "integer", "minimum": 0},
        "dialogue_relations": {"type": "integer", "minimum": 0},
        "temporally_linked_turns": {"type": "integer", "minimum": 0},
        "unlinked_turns": {"type": "integer", "minimum": 0},
        "observed_edges": {"type": "integer", "minimum": 0},
        "inferred_edges": {"type": "integer", "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "epistemic_status", "confidence", "evidence_refs", "attributes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["person", "visual_identity", "scene", "object", "topic", "opinion", "intent"]},
        "label": {"type": "string", "minLength": 1},
        "epistemic_status": {"enum": ["observed", "inferred"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "attributes": {"type": "object"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "predicate", "epistemic_status", "confidence", "start_ms", "end_ms", "evidence_refs", "attributes"],
      "properties": {
        "id": {"type": "string", "pattern": "^edge-[0-9]{6}$"},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "epistemic_status": {"enum": ["observed", "inferred"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "attributes": {"type": "object"}
      }
    }
  }
}
