{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hightorque.local/schemas/vision-evaluation-annotations-v1.json",
  "title": "HT Vision Lab human evaluation annotations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_type", "sample_id", "source", "provenance", "identity_bindings", "keyframes"],
  "properties": {
    "schema_version": {"const": 1},
    "context_type": {"const": "vision_evaluation_annotations"},
    "sample_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_sha256", "duration_ms"],
      "properties": {
        "video_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reviewed_at", "notes"],
      "properties": {
        "method": {"const": "manual_evidence_review"},
        "reviewed_at": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      }
    },
    "identity_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker_label", "face_id"],
        "properties": {
          "speaker_label": {"enum": ["A", "B", "C", "D"]},
          "face_id": {"type": "string", "pattern": "^Face-[0-9]{2}$"}
        }
      }
    },
    "object_vocabulary": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "interaction_predicates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["speaking", "listening", "presenting", "showing", "holding", "using", "pointing_to", "sitting_with", "standing_with", "touching", "other"]
      }
    },
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/keyframe"}
    }
  },
  "$defs": {
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyframe_id", "timestamp_ms"],
      "anyOf": [
        {"required": ["environment_category"]},
        {"required": ["object_labels"]},
        {"required": ["interactions"]},
        {"required": ["spatial_relations"]}
      ],
      "properties": {
        "keyframe_id": {"type": "string", "pattern": "^keyframe-[0-9]{5}$"},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "environment_category": {
          "enum": [
            "indoor_meeting", "indoor_office", "indoor_studio", "indoor_home",
            "indoor_public", "outdoor_public", "outdoor_nature", "stage",
            "vehicle", "graphic_or_title", "other", "unknown"
          ]
        },
        "object_labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "interactions": {
          "type": "array",
          "items": {"$ref": "#/$defs/interaction"}
        },
        "spatial_relations": {
          "type": "array",
          "items": {"$ref": "#/$defs/spatialRelation"}
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "predicate", "object_ref"],
      "properties": {
        "subject_ref": {"type": "string", "minLength": 1},
        "predicate": {
          "enum": ["speaking", "listening", "presenting", "showing", "holding", "using", "pointing_to", "sitting_with", "standing_with", "touching", "other"]
        },
        "object_ref": {"type": ["string", "null"]}
      }
    },
    "spatialRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "predicate", "object_ref"],
      "properties": {
        "subject_ref": {"type": "string", "pattern": "^Face-[0-9]{2}$"},
        "predicate": {"enum": ["co_visible_with", "left_of", "above", "visually_close_to", "overlaps_in_image"]},
        "object_ref": {"type": "string", "pattern": "^Face-[0-9]{2}$"}
      }
    }
  }
}
