{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hightorque.local/schemas/scene-context-v1.json",
  "title": "HT Vision Lab visual scene context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_type", "session_id", "created_at", "source", "processing", "visual_entities", "shots", "keyframes", "person_states", "spatial_relations", "statistics", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "context_type": {"const": "visual_scene_context"},
    "session_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "processing": {"$ref": "#/$defs/processing"},
    "visual_entities": {"type": "array", "items": {"$ref": "#/$defs/visualEntity"}},
    "shots": {"type": "array", "items": {"$ref": "#/$defs/shot"}},
    "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframe"}},
    "person_states": {"type": "array", "items": {"$ref": "#/$defs/personState"}},
    "spatial_relations": {"type": "array", "items": {"$ref": "#/$defs/spatialRelation"}},
    "statistics": {"$ref": "#/$defs/statistics"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_tracks_path", "visual_tracks_sha256", "video_path", "video_sha256", "duration_ms", "fps", "width", "height"],
      "properties": {
        "visual_tracks_path": {"type": "string"},
        "visual_tracks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "video_path": {"type": "string"},
        "video_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_detector", "keyframe_selector", "spatial_relations"],
      "properties": {
        "shot_detector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "adaptive_threshold", "min_content_val", "min_shot_seconds"],
          "properties": {
            "name": {"const": "PySceneDetect AdaptiveDetector"},
            "version": {"type": "string"},
            "adaptive_threshold": {"type": "number", "exclusiveMinimum": 0},
            "min_content_val": {"type": "number", "minimum": 0},
            "min_shot_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "keyframe_selector": {
          "enum": [
            "best_of_20_50_80_by_sharpness_and_visible_faces_v1",
            "best_of_20_50_80_by_sharpness_and_visible_faces_v2"
          ]
        },
        "spatial_relations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "horizontal_threshold", "vertical_threshold", "near_threshold", "overlap_iou_threshold"],
          "properties": {
            "algorithm": {"const": "normalized_face_box_geometry_v1"},
            "horizontal_threshold": {"type": "number", "minimum": 0, "maximum": 1},
            "vertical_threshold": {"type": "number", "minimum": 0, "maximum": 1},
            "near_threshold": {"type": "number", "exclusiveMinimum": 0},
            "overlap_iou_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          }
        }
      }
    },
    "visualEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["face_id", "speaker_label", "identity_status"],
      "properties": {
        "face_id": {"type": "string", "pattern": "^Face-[0-9]{2}$"},
        "speaker_label": {"enum": ["A", "B", "C", "D", null]},
        "identity_status": {"enum": ["confirmed", "visual_only"]}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "start_ms", "end_ms", "keyframe_ids", "semantic_scene_id"],
      "properties": {
        "shot_id": {"type": "string", "pattern": "^shot-[0-9]{5}$"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "keyframe_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "semantic_scene_id": {"type": ["string", "null"]}
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyframe_id", "shot_id", "timestamp_ms", "frame_index", "image_path", "annotated_image_path", "sharpness", "selection_score", "person_state_ids"],
      "properties": {
        "keyframe_id": {"type": "string", "pattern": "^keyframe-[0-9]{5}$"},
        "shot_id": {"type": "string"},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "frame_index": {"type": "integer", "minimum": 0},
        "image_path": {"type": "string"},
        "annotated_image_path": {"type": "string"},
        "sharpness": {"type": "number", "minimum": 0},
        "selection_score": {"type": "number", "minimum": 0, "maximum": 1},
        "person_state_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "personState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["person_state_id", "keyframe_id", "face_id", "speaker_label", "identity_status", "source_observation_id", "bbox_normalized", "center_normalized", "horizontal_region", "vertical_region", "area_ratio", "detection_confidence", "head_orientation"],
      "properties": {
        "person_state_id": {"type": "string", "pattern": "^person-state-[0-9]{6}$"},
        "keyframe_id": {"type": "string"},
        "face_id": {"type": "string", "pattern": "^Face-[0-9]{2}$"},
        "speaker_label": {"enum": ["A", "B", "C", "D", null]},
        "identity_status": {"enum": ["confirmed", "visual_only"]},
        "source_observation_id": {"type": "string"},
        "bbox_normalized": {"$ref": "#/$defs/normalizedBox"},
        "center_normalized": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "horizontal_region": {"enum": ["left", "center", "right"]},
        "vertical_region": {"enum": ["upper", "middle", "lower"]},
        "area_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "detection_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "head_orientation": {"type": "null"}
      }
    },
    "normalizedBox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "spatialRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "keyframe_id", "subject_state_id", "predicate", "object_state_id", "coordinate_space", "confidence"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^spatial-relation-[0-9]{6}$"},
        "keyframe_id": {"type": "string"},
        "subject_state_id": {"type": "string"},
        "predicate": {"enum": ["co_visible_with", "left_of", "above", "visually_close_to", "overlaps_in_image"]},
        "object_state_id": {"type": "string"},
        "coordinate_space": {"const": "image_normalized"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shots", "keyframes", "person_states", "spatial_relations"],
      "properties": {
        "shots": {"type": "integer", "minimum": 0},
        "keyframes": {"type": "integer", "minimum": 0},
        "person_states": {"type": "integer", "minimum": 0},
        "spatial_relations": {"type": "integer", "minimum": 0}
      }
    }
  }
}
